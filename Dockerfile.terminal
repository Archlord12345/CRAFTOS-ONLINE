FROM ubuntu:22.04

# Avoid interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install basic packages and dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    ncurses-bin \
    curl \
    wget \
    nano \
    vim \
    htop \
    tree \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for the interface
RUN pip3 install rich colorama

# Create the NEON OS directory structure
RUN mkdir -p /neon-os/{realms,storage,system_tools}

# Create the main OS script
COPY neon_os.py /neon-os/
COPY welcome.sh /neon-os/

# Make scripts executable
RUN chmod +x /neon-os/neon_os.py /neon-os/welcome.sh

# Set working directory
WORKDIR /neon-os

# Create a simple web server for health checks
RUN echo 'from http.server import HTTPServer, SimpleHTTPRequestHandler\nimport os\n\nclass HealthHandler(SimpleHTTPRequestHandler):\n    def do_GET(self):\n        self.send_response(200)\n        self.send_header("Content-type", "text/plain")\n        self.end_headers()\n        self.wfile.write(b"NEON OS Terminal Service Running")\n\nif __name__ == "__main__":\n    port = int(os.environ.get("PORT", 8000))\n    server = HTTPServer(("0.0.0.0", port), HealthHandler)\n    print(f"Health server running on port {port}")\n    server.serve_forever()' > /neon-os/health_server.py

# Expose port for health checks
EXPOSE 8000

# Start both health server and NEON OS
RUN echo '#!/bin/bash\npython3 health_server.py &\n./welcome.sh' > /neon-os/start.sh && chmod +x /neon-os/start.sh

CMD ["/neon-os/start.sh"]
