FROM ubuntu:22.04

# Éviter les prompts interactifs
ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99

# Installer KDE Plasma et les dépendances
RUN apt-get update && apt-get install -y \
    # KDE Plasma Desktop minimal
    kde-plasma-desktop \
    # PyQt5 pour l'interface graphique
    python3-pyqt5 \
    # Serveur X virtuel
    xvfb \
    # Navigateur web
    firefox \
    # Outils système
    python3 \
    python3-pip \
    curl \
    wget \
    nano \
    vim \
    htop \
    tree \
    # Nettoyage
    && apt-get autoremove -y \
    && apt-get autoclean \
    && rm -rf /var/lib/apt/lists/*

# Installer les dépendances Python
RUN pip3 install flask rich colorama

# Créer utilisateur pour KDE
RUN useradd -m -s /bin/bash neonuser \
    && echo "neonuser:neon123" | chpasswd

# Créer le répertoire de travail
WORKDIR /app

# Copier les applications
COPY web_app.py /app/
COPY kde_launcher.py /app/
COPY kde_desktop.py /app/

# Donner les permissions
RUN chown -R neonuser:neonuser /app \
    && chmod +x /app/kde_launcher.py \
    && chmod +x /app/kde_desktop.py

# Script de démarrage KDE
RUN echo '#!/bin/bash\n# Démarrer le serveur X virtuel\nXvfb :99 -screen 0 1024x768x24 &\n# Attendre que X soit prêt\nsleep 3\n# Démarrer l\'application KDE\nexport DISPLAY=:99\nsu - neonuser -c "python3 /app/kde_launcher.py &"\n# Démarrer l\'application web\npython3 web_app.py' > /app/start_kde.sh \
    && chmod +x /app/start_kde.sh

# Exposer les ports
EXPOSE 8000

# Démarrer KDE et l'application
CMD ["/app/start_kde.sh"]
