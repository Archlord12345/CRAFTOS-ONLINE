FROM ubuntu:22.04

# Éviter les prompts interactifs
ENV DEBIAN_FRONTEND=noninteractive

# Installer les dépendances Python et Minecraft
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    git \
    curl \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Installer les bibliothèques Python pour Minecraft
RUN pip3 install --no-cache-dir \
    flask \
    flask-socketio \
    eventlet \
    mcpi \
    numpy \
    requests

# Installer le serveur Minecraft (si nécessaire)
RUN mkdir -p /minecraft/server \
    && cd /minecraft/server \
    && wget -O server.jar https://launcher.mojang.com/v1/objects/8f3112a1049751cc472ec13a397e24deb750df3c/server.jar \
    && echo "eula=true" > eula.txt

# Créer le répertoire de travail
WORKDIR /app

# Copier les fichiers du bot
COPY minecraft_bot.py /app/
COPY minecraft_server_manager.py /app/

# Créer les répertoires nécessaires
RUN mkdir -p /app/logs /app/configs

# Script de démarrage
RUN echo '#!/bin/bash\n\
echo "🚀 Démarrage de NEON OS Minecraft Bot..."\n\
\n\
# Démarrer le serveur Minecraft si nécessaire\n\
if [ "$MINECRAFT_SERVER" = "true" ]; then\n\
    echo "🎮 Démarrage du serveur Minecraft..."\n\
    cd /minecraft/server\n\
    java -Xmx1024M -Xms1024M -jar server.jar nogui &\n\
    sleep 10\n\
fi\n\
\n\
# Démarrer le bot NEON OS\n\
echo "🤖 Démarrage du bot NEON OS..."\n\
python3 minecraft_bot.py' > /app/start_bot.sh \
    && chmod +x /app/start_bot.sh

# Exposer les ports
EXPOSE 8000 25565

# Variables d'environnement
ENV MINECRAFT_SERVER=false
ENV SERVER_HOST=localhost
ENV SERVER_PORT=25565

# Démarrer le bot
CMD ["/app/start_bot.sh"]
